# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=bullsai
BULLSAI_API_KEY=
BULLSAI_BASE_URL=
BULLSAI_MODEL=google/gemma-4-31B-it
# optional: helper model for follow-up rewrite and off-topic check (defaults to BULLSAI_MODEL)
BULLSAI_REWRITE_MODEL=
# default = leave the gateway's reasoning setting; off = send thinking disabled (ignored by the gateway on long prompts)
BULLSAI_THINKING=default
# on (default) = rerank the top 25 passages with the BullsAI reranker; falls back silently on any error
RERANK=on

# Trusted-web fallback (last tier: only when the notes, dissection guides and OpenStax found nothing, for a clear anatomy
# question; never for treatment/dosing or off-topic questions). The allowed sites are listed in src/web_sources.py.
WEB_FALLBACK=on
# Wikipedia (en only) is approved by Dr. Inglis and ON; it is asked first, MeSH/MedlinePlus supplement it
WEB_ALLOW_WIKIPEDIA=on
# optional: Tavily search, restricted to the allowed domains (keyless sources are used without it)
TAVILY_API_KEY=
# chat history (Q&A): chats with no activity for this many days are deleted
CHAT_RETENTION_DAYS=90
